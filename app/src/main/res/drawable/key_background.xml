<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed_dark" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/accent_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_normal_dark" />
            <corners android:radius="8dp" />
            <padding android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp" />
            <stroke android:width="0.5dp" android:color="@color/key_shadow_dark" />
        </shape>
    </item>
</selector>
