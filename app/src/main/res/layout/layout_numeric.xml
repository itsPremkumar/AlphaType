<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <!-- Row 1: 1234567890 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="1" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="2" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="3" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="4" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="5" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="6" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="7" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="8" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="9" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="0" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 2: @#%&*-+() -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="\@" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="#" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="%" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="&amp;" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="*" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="-" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="+" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="(" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text=")" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="/" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 3: Symbols + Delete -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="!" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="?" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="\&quot;" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="\'" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text=":" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text=";" android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="," android:layout_weight="1" />
        <Button style="@style/KeyStyle" android:text="." android:layout_weight="1" />
        <ImageButton style="@style/KeyStyle.Special" android:src="@drawable/ic_backspace" android:tag="⌫" android:layout_weight="2" android:scaleType="centerInside" android:tint="@color/text_color_dark" />
    </LinearLayout>

    <!-- Row 4: ABC, Comma, Globe, Space, Period, Enter -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button style="@style/KeyStyle.Special" android:text="ABC" android:layout_weight="1.5" />
        <Button style="@style/KeyStyle" android:text="," android:layout_weight="1" />
        <ImageButton style="@style/KeyStyle.Special" android:src="@drawable/ic_globe" android:tag="GLOBE" android:layout_weight="1.2" android:scaleType="centerInside" android:tint="@color/text_color_dark" />
        <Button style="@style/KeyStyle" android:text="SPACE" android:layout_weight="3.5" android:textColor="@android:color/transparent" />
        <Button style="@style/KeyStyle" android:text="." android:layout_weight="1" />
        <ImageButton style="@style/KeyStyle.Accent" android:src="@drawable/ic_enter" android:tag="ENTER" android:layout_weight="1.5" android:scaleType="centerInside" android:tint="@color/text_color_dark" />
    </LinearLayout>

</LinearLayout>
